{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "location": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "publicKey": { "type": "string" },
        "encryptionEnabled": { "type": "boolean" }
      },
      "required": ["uid", "displayName"]
    },
    "Post": {
      "title": "Post",
      "description": "Social media post",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "media": { "type": "array" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "isModerated": { "type": "boolean" },
        "isRepost": { "type": "boolean" },
        "originalPostId": { "type": "string" },
        "originalAuthorId": { "type": "string" },
        "originalAuthorName": { "type": "string" },
        "originalContent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message (E2EE supported)",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "ciphertext": { "type": "string" },
        "nonce": { "type": "string" },
        "isEncrypted": { "type": "boolean" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "createdAt"]
    },
    "Video": {
      "title": "Video",
      "description": "Short-form video content",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "caption": { "type": "string" },
        "videoUrl": { "type": "string" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "videoUrl", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Conversation between users",
      "type": "object",
      "properties": {
        "participants": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "typing": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "updatedAt"]
    },
    "MarketItem": {
      "title": "MarketItem",
      "description": "Item listed for sale in the marketplace",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "images": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "sold", "deleted"] },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "name", "price", "createdAt"]
    },
    "VideoLike": {
      "title": "VideoLike",
      "description": "A like on a video",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "userId", "createdAt"]
    },
    "VideoComment": {
      "title": "VideoComment",
      "description": "A comment on a video",
      "type": "object",
      "properties": {
        "videoId": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "userId", "text", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["like", "comment", "follow", "mention"] },
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "fromPhoto": { "type": "string" },
        "message": { "type": "string" },
        "link": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "fromId", "message", "read", "createdAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "User wallet balance and settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "number" },
        "currency": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "balance", "currency"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Wallet transaction record",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "toId": { "type": "string" },
        "fromName": { "type": "string" },
        "toName": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["send", "receive", "topup", "cashout", "billpay", "escrow_hold", "escrow_release", "pool_contribution"] },
        "status": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["amount", "type", "status", "createdAt"]
    },
    "AIChat": {
      "title": "AIChat",
      "description": "Interaction with Zathu Smart Assistant (E2EE supported)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "ciphertext": { "type": "string" },
        "isEncrypted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "text", "createdAt"]
    },
    "MarketEscrow": {
      "title": "MarketEscrow",
      "description": "Escrow hold for marketplace transaction",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "buyerId": { "type": "string" },
        "sellerId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["held", "released", "refunded"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "buyerId", "sellerId", "amount", "status"]
    },
    "MarketReview": {
      "title": "MarketReview",
      "description": "Review and rating for a seller",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "buyerId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "buyerId", "rating", "createdAt"]
    },
    "SavingsPool": {
      "title": "SavingsPool",
      "description": "Community savings group (Chitipa)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "creatorId": { "type": "string" },
        "members": { "type": "array" },
        "targetAmount": { "type": "number" },
        "contributionAmount": { "type": "number" },
        "frequency": { "type": "string", "enum": ["weekly", "monthly"] },
        "totalCollected": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "creatorId", "contributionAmount", "frequency", "status"]
    },
    "Story": {
      "title": "Story",
      "description": "Disappearing 24h content",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "mediaUrl", "expiresAt", "createdAt"]
    },
    "Ad": {
      "title": "Ad",
      "description": "Advertisement campaign",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "targetUrl": { "type": "string" },
        "adType": { "type": "string", "enum": ["sponsored_post", "banner", "marketplace_boost"] },
        "status": { "type": "string", "enum": ["active", "paused", "completed"] },
        "budget": { "type": "number" },
        "spent": { "type": "number" },
        "impressions": { "type": "number" },
        "clicks": { "type": "number" },
        "placement": { "type": "string", "enum": ["feed", "sidebar", "marketplace"] },
        "ctaText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl", "adType", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/ads/{adId}": {
      "schema": "Ad",
      "description": "Advertisement campaigns"
    },
    "/wallets/{walletId}": {
      "schema": "Wallet",
      "description": "User wallets (doc ID is userId)"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial transactions"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    },
    "/users/{userId}/savedPosts/{postId}": {
      "schema": "object",
      "description": "Saved posts references"
    },
    "/users/{userId}/followers/{followerId}": {
      "schema": "object",
      "description": "User followers"
    },
    "/users/{userId}/following/{followingId}": {
      "schema": "object",
      "description": "Users followed by this user"
    },
    "/users/{userId}/likedItems/{itemId}": {
      "schema": "object",
      "description": "Market items liked by the user"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public posts"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Conversations"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages"
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Short-form videos"
    },
    "/videoLikes/{likeId}": {
      "schema": "VideoLike",
      "description": "Video likes"
    },
    "/videoComments/{commentId}": {
      "schema": "VideoComment",
      "description": "Video comments"
    },
    "/postLikes/{likeId}": {
      "schema": "object",
      "description": "Post likes"
    },
    "/postComments/{commentId}": {
      "schema": "object",
      "description": "Post comments"
    },
    "/marketItems/{itemId}": {
      "schema": "MarketItem",
      "description": "Marketplace listings"
    },
    "/ai_chats/{chatId}": {
      "schema": "AIChat",
      "description": "AI Assistant chat history"
    },
    "/escrows/{escrowId}": {
      "schema": "MarketEscrow",
      "description": "Marketplace escrows"
    },
    "/reviews/{reviewId}": {
      "schema": "MarketReview",
      "description": "Seller reviews"
    },
    "/savings_pools/{poolId}": {
      "schema": "SavingsPool",
      "description": "Chitipa savings groups"
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "Temporary stories"
    }
  }
}
