rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, displayName, email, photoURL, bio, location, isVerified, createdAt
    //
    // Collection: posts
    // Fields: postId, authorId, content, media, likesCount, commentsCount, isModerated, createdAt
    //
    // Collection: chats/{chatId}/messages
    // Fields: senderId, text, createdAt
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName']) &&
             data.uid is string && data.displayName is string &&
             data.displayName.size() > 0 && data.displayName.size() < 50;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'content', 'createdAt']) &&
             data.authorId == request.auth.uid &&
             data.content is string && data.content.size() > 0 && data.content.size() < 5000;
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['userId', 'videoUrl', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.videoUrl is string && data.videoUrl.size() > 0 &&
             (!('caption' in data) || (data.caption is string && data.caption.size() < 500)) &&
             (!('likesCount' in data) || (data.likesCount is number)) &&
             (!('commentsCount' in data) || (data.commentsCount is number));
    }

    function isValidVideoLike(data) {
      return data.keys().hasAll(['videoId', 'userId', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.videoId is string && data.videoId.size() > 0;
    }

    function isValidVideoComment(data) {
      return data.keys().hasAll(['videoId', 'userId', 'text', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.text is string && data.text.size() > 0 && data.text.size() < 500;
    }

    function isValidMarketItem(data) {
      return data.keys().hasAll(['sellerId', 'name', 'price', 'createdAt']) &&
             data.sellerId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.price is number && data.price >= 0 &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             (!('location' in data) || (data.location is string && data.location.size() < 100)) &&
             (!('category' in data) || (data.category is string && data.category.size() < 50)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
             (!('status' in data) || (data.status in ['active', 'sold', 'deleted']));
    }

    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.email == "aufiseleman58@gmail.com" && request.auth.token.email_verified == true);
    }

    function isChatParticipant(chatId) {
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUserOwner(userId) && isValidUser(request.resource.data);
      allow update: if isUserOwner(userId) || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'lastSeen']));

      match /notifications/{notificationId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow create: if isAuthenticated(); // Allow users to send notifications to others
        allow update: if isUserOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isUserOwner(userId);
      }

      match /savedPosts/{postId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow write: if isUserOwner(userId);
      }

      match /following/{followingId} {
        allow read: if true;
        allow write: if isUserOwner(userId);
      }

      match /likedItems/{itemId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow write: if isUserOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == followerId;
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidPost(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidVideo(request.resource.data);
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /videoLikes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidVideoLike(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /videoComments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidVideoComment(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /marketItems/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidMarketItem(request.resource.data);
      allow update: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId) && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
