rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // PILLAR 0: Global Safety Net (Default-Deny)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isAdmin() {
      return isVerified() && 
             (('email' in request.auth.token && request.auth.token.email == "aufiseleman58@gmail.com") || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin'));
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isValidId(id) { 
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Validation Blueprints (Pillar 2)
    // ===============================================================
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName']) &&
             data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() < 100 &&
             (!('role' in data) || data.role in ['user', 'admin']);
    }

    function isValidPost(data) {
      return data.keys().hasAll(['authorId', 'content', 'createdAt']) &&
             data.authorId == request.auth.uid &&
             data.content is string && data.content.size() >= 0 && data.content.size() < 5000 &&
             data.createdAt == request.time;
    }

    function isValidWallet(data) {
      return data.keys().hasAll(['userId', 'balance', 'currency']) &&
             data.userId == request.auth.uid &&
             data.balance is number && data.balance >= 0 &&
             data.currency is string && data.currency.size() == 3;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['fromId', 'toId', 'amount', 'type', 'status', 'createdAt']) &&
             data.amount is number && data.amount > 0 &&
             data.type in ['send', 'receive', 'topup', 'cashout', 'billpay', 'escrow_hold', 'escrow_release', 'pool_contribution', 'ad_payment'] &&
             data.status in ['pending', 'completed', 'failed'] &&
             data.createdAt == request.time;
    }

    function isValidAIChat(data) {
      return data.keys().hasAll(['userId', 'role', 'text', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.role in ['user', 'model'] &&
             data.text is string && data.text.size() > 0;
    }

    function isValidSavingsPool(data) {
      return data.keys().hasAll(['name', 'creatorId', 'members', 'contributionAmount', 'frequency', 'status', 'createdAt']) &&
             data.creatorId == request.auth.uid &&
             data.members is list && data.members.size() > 0 &&
             data.createdAt == request.time;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /_health_/{docId} {
      allow read: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isVerified();
      allow list: if isVerified();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isVerified', 'uid', 'email'])) || 
                     isAdmin();

      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isVerified() && isValidId(notificationId); 
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isOwner(userId);
      }

      match /savedPosts/{postId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) && isValidId(postId);
      }

      match /following/{followingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(followingId);
      }

      match /likedItems/{itemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) && isValidId(itemId);
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if isOwner(followerId) && isValidId(userId);
      }
    }

    // Wallets & Transactions (Pillar 4 & 7)
    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || isAdmin();
      allow create: if (isOwner(walletId) && isValidWallet(incoming())) || (
        isVerified() && 
        incoming().userId == walletId && 
        incoming().balance >= 0 && 
        incoming().currency == 'MWK' &&
        incoming().updatedAt == request.time
      );
      allow update: if isOwner(walletId) || isAdmin() || (
        isVerified() && 
        incoming().balance > existing().balance &&
        incoming().userId == existing().userId &&
        incoming().currency == existing().currency &&
        incoming().updatedAt == request.time
      );
    }

    match /transactions/{transactionId} {
      allow read: if isVerified() && (
        resource.data.fromId == request.auth.uid || 
        resource.data.toId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isVerified() && 
                     isValidId(transactionId) && 
                     isValidTransaction(incoming()) &&
                     (incoming().fromId == request.auth.uid || (incoming().type in ['topup', 'receive'] && incoming().toId == request.auth.uid));
      allow update, delete: if isAdmin();
    }

    // Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isVerified() && isValidId(postId) && isValidPost(incoming());
      allow update: if isVerified() && (
        resource.data.authorId == request.auth.uid || 
        isAdmin() || 
        incoming().diff(existing()).affectedKeys().hasOnly(['sharesCount', 'likesCount', 'commentsCount', 'isPromoted', 'promotedUntil'])
      );
      allow delete: if isVerified() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Post Interactions
    match /postLikes/{likeId} {
      allow read: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(likeId) && incoming().userId == request.auth.uid;
      allow delete: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /postComments/{commentId} {
      allow read: if true;
      allow create: if isVerified() && isValidId(commentId) && incoming().userId == request.auth.uid;
      allow update, delete: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Marketplace
    match /marketItems/{itemId} {
      allow read: if true;
      allow create: if isVerified() && isValidId(itemId);
      allow update, delete: if isVerified() && (
        resource.data.sellerId == request.auth.uid || 
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly(['isPromoted', 'promotedUntil', 'likesCount'])
      );
    }

    // Ads
    match /ads/{adId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(adId);
      allow update: if isAdmin() || (
        (incoming().diff(existing()).affectedKeys().hasOnly(['impressions']) && incoming().impressions == existing().impressions + 1) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['clicks']) && incoming().clicks == existing().clicks + 1)
      );
      allow delete: if isAdmin();
    }

    match /ai_chats/{chatId} {
      allow read: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(chatId) && incoming().userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /userInteractions/{id} {
      allow read: if isAdmin();
      allow create: if isVerified() && incoming().userId == request.auth.uid;
    }

    match /escrows/{escrowId} {
      allow read: if isVerified() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(escrowId);
      allow update: if isVerified() && (
        (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin()) &&
        (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
    }

    match /savings_pools/{poolId} {
      allow read: if isVerified();
      allow create: if isVerified() && isValidId(poolId) && isValidSavingsPool(incoming());
      allow update: if isVerified() && (
        (request.auth.uid in resource.data.members || resource.data.creatorId == request.auth.uid) ||
        // Action: Join
        (incoming().members.hasAll(existing().members) && 
         request.auth.uid in incoming().members &&
         incoming().diff(existing()).affectedKeys().hasOnly(['members', 'updatedAt']))
      );
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow delete: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isVerified() && request.auth.uid in resource.data.participants;
      allow create: if isVerified() && request.auth.uid in incoming().participants;
      allow update: if isVerified() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read: if isVerified() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isVerified() && 
                      request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants && 
                      incoming().senderId == request.auth.uid;
      }
    }

    // Videos
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isVerified() && (incoming().userId == request.auth.uid);
      allow update: if isVerified() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() || 
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'isPromoted', 'promotedUntil'])
      );
      allow delete: if isVerified() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Call System
    match /calls/{callId} {
      allow read, create, update: if isVerified();
      allow delete: if isVerified() && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid || isAdmin());
      
      match /callerCandidates/{candidateId} { allow read, write: if isVerified(); }
      match /calleeCandidates/{candidateId} { allow read, write: if isVerified(); }
    }
  }
}
